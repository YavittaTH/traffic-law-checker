# --- required: class LLM proxy (base URL ends in /v1) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- model ---
LLM_MODEL=gemma-4-E4B-it

# --- retrieval ---
# bge-m3 handles Thai well; after changing this, rebuild the index: python scripts/build_index.py
EMBED_MODEL=BAAI/bge-m3

# --- classic RAG (rag.py): sources per answer and BM25 floor, picked by eval/run_min_score.py ---
RAG_K=8
RAG_MIN_SCORE=1.0

# --- agent (allowed range: 1-20) ---
AGENT_MAX_STEPS=6

# --- point system (ระเบียบ...คะแนนความประพฤติ พ.ศ. ๒๕๖๕) ---
# starting points per driver, ข้อ ๗ (verify against the current สตช. regulation)
POINTS_START=12
# maximum points deducted per incident, ข้อ ๑๑ วรรคท้าย
POINTS_INCIDENT_CAP=8
