# --- required: class LLM proxy (base URL ends in /v1) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- model ---
LLM_MODEL=gemma-4-E4B-it

# --- retrieval ---
# bge-m3 handles Thai well; switching models means re-picking MIN_SCORE
EMBED_MODEL=BAAI/bge-m3
TOP_K=8
MIN_SCORE=0.0

# --- classic RAG (rag.py): sources per answer and BM25 floor, picked by eval/run_min_score.py ---
RAG_K=8
RAG_MIN_SCORE=1.0

# --- agent ---
AGENT_MAX_STEPS=6

# --- point system: starting points per driver (verify against the current สตช. regulation) ---
POINTS_START=12
